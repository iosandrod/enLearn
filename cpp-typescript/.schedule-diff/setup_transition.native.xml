<?python
import frepple, json
frepple.solver_mrp(plantype=1, constraints=15, loglevel=0).solve()
def stamp(value):
    return value.strftime("%Y-%m-%dT%H:%M:%S")
def name(value):
    return getattr(value, "name", None) if value is not None else None
plans = []
all_buffers = list(frepple.buffers())
all_resources = list(frepple.resources())
for operationplan in frepple.operationplans():
    materials = []
    for buffer in all_buffers:
        for flowplan in buffer.flowplans:
            if flowplan.operationplan == operationplan:
                materials.append({"buffer": buffer.name, "date": stamp(flowplan.date), "quantity": flowplan.quantity})
    resources = []
    for resource in all_resources:
        if any(loadplan.operationplan == operationplan for loadplan in resource.loadplans):
            resources.append(resource.name)
    owner = getattr(operationplan, "owner", None)
    plans.append({
        "operation": operationplan.operation.name,
        "demand": name(getattr(operationplan, "demand", None)),
        "quantity": operationplan.quantity,
        "start": stamp(operationplan.start),
        "end": stamp(operationplan.end),
        "ownerOperation": name(getattr(owner, "operation", None)),
        "status": operationplan.status,
        "feasible": bool(operationplan.feasible),
        "resources": sorted(resources),
        "materials": sorted(materials, key=lambda value: (value["date"], value["buffer"], value["quantity"])),
    })
plans.sort(key=lambda value: (value["operation"], value["start"], value["end"], value["demand"] or "", value["quantity"]))
deliveries = []
for demand in frepple.demands():
    for operationplan in demand.operationplans:
        deliveries.append({"demand": demand.name, "quantity": operationplan.quantity, "end": stamp(operationplan.end)})
deliveries.sort(key=lambda value: (value["demand"], value["end"], value["quantity"]))
with open("/workspace/cpp-typescript/.schedule-diff/setup_transition.native.json", "w", encoding="utf-8") as output:
    json.dump({"operationPlans": plans, "deliveries": deliveries}, output, indent=2, sort_keys=True)
?>
