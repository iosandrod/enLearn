API_PORT=3002
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
REDIS_URL=redis://127.0.0.1:6379

# Typed workflow adapter security boundaries.
WORKFLOW_INTERNAL_API_URL=http://127.0.0.1:3002/api
WORKFLOW_INTERNAL_KEY=
# Comma-separated additional exact origins and public RPC function names.
WORKFLOW_HTTP_ALLOWED_ORIGINS=
WORKFLOW_RPC_ALLOWED_FUNCTIONS=
WORKFLOW_CAPABILITY_TIMEOUT_MS=30000
WORKFLOW_HTTP_MAX_RESPONSE_BYTES=1048576

# Trigger.dev runtime credentials are resolved from its database at runtime.
TRIGGER_API_URL=http://localhost:3030
# TRIGGER_ENV_FILE=E:\trigger.dev-main\.env
# TRIGGER_PROJECT_NAME=enlearn-workflow-local
# TRIGGER_ENVIRONMENT=dev
# Optional but required when the UI must verify whether a development worker is online.
# TRIGGER_ACCESS_TOKEN=tr_pat_...
# TRIGGER_CREDENTIAL_CACHE_TTL_MS=300000

# Planning execution. The fixed Python bridge never receives database credentials.
PLANNING_ENGINE_MODE=process
# PLANNING_FREPPLE_EXECUTABLE=frepple
# PLANNING_FREPPLE_BRIDGE=E:\enLearn\api\src\planning-service\execution\frepple-engine.py
# Local sidecar: docker compose -f infra/planning/docker-compose.yml up -d --build
# PLANNING_ENGINE_ENDPOINT=http://localhost:8088/solve
# Trigger.dev containers reach a host-published sidecar with:
# PLANNING_ENGINE_ENDPOINT=http://host.docker.internal:8088/solve
# PLANNING_ENGINE_TOKEN=
PLANNING_ENGINE_TIMEOUT_MS=3600000
PLANNING_ENGINE_MAX_RESPONSE_BYTES=268435456
PLANNING_ENGINE_MAX_LOG_BYTES=10485760
PLANNING_ENGINE_MAX_LOG_LINES=100000
PLANNING_DATABASE_POOL_SIZE=4
