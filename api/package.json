    "db:test": "tsx scripts/test-db-connection.ts",
    "db:apply-permissions": "tsx scripts/apply-permission-schema.ts",
    "db:apply-file-storage": "tsx scripts/apply-file-storage-system.ts",
    "db:apply-trigger-workflow-route": "tsx scripts/apply-trigger-workflow-route.ts",
    "db:generate-lowcode-table-page": "tsx scripts/generate-lowcode-table-page.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.5",
    "@nestjs/core": "^10.4.5",
    "@nestjs/platform-express": "^10.4.5",
