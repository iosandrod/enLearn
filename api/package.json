{
  "name": "hikari-api",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "domain:dev": "tsx watch src/domain-service/main.ts",
    "domain:build": "pnpm build",
    "domain:start": "node dist/domain-service/main.js",
    "domain:typecheck": "pnpm typecheck",
    "workflow:dev": "tsx watch src/workflow-service/main.ts",
    "workflow:build": "pnpm build",
    "workflow:start": "node dist/workflow-service/main.js",
    "workflow:typecheck": "pnpm typecheck",
    "workflow:test": "tsx src/workflow/definition/definition.service.spec.ts && tsx src/workflow/runtime/runtime.service.spec.ts",
    "workflow:db:apply-trigger-runtime": "tsx scripts/apply-workflow-jobs-migration.ts",
    "workflow:db:apply-jobs": "pnpm workflow:db:apply-trigger-runtime",
    "workflow:smoke:trigger-waitpoint": "tsx scripts/smoke-trigger-waitpoint.ts",
    "workflow:smoke:system-minimal-approval": "tsx scripts/smoke-system-minimal-approval.ts",
    "workflow:trigger:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-trigger-dev.ps1 -ApiUrl http://localhost:3030 -EnvFile %INIT_CWD%\\.env",
    "workflow:trigger:deploy": "trigger deploy -a http://localhost:3030 --env-file %INIT_CWD%\\.env",
    "db:test": "tsx scripts/test-db-connection.ts",
    "db:apply-permissions": "tsx scripts/apply-permission-schema.ts",
    "db:apply-file-storage": "tsx scripts/apply-file-storage-system.ts",
    "db:apply-chat-socket": "tsx scripts/apply-chat-socket-system.ts",
    "db:apply-trigger-workflow-route": "tsx scripts/apply-trigger-workflow-route.ts",
    "db:generate-lowcode-table-page": "tsx scripts/generate-lowcode-table-page.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.5",
    "@nestjs/core": "^10.4.5",
    "@nestjs/microservices": "^10.4.22",
    "@nestjs/platform-express": "^10.4.5",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/websockets": "^10.4.22",
    "@trigger.dev/sdk": "4.5.7",
    "@supabase/supabase-js": "2.110.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "pg": "^8.22.0",
    "ioredis": "^5.3.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "stripe": "^14.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/pg": "^8.11.10",
    "@trigger.dev/build": "4.5.7",
    "tsx": "^4.19.2",
    "trigger.dev": "4.5.7",
    "typescript": "^5.4.5"
  },
  "packageManager": "pnpm@10.15.1"
}
