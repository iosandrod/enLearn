{
  "name": "@enlearn/mobile-app",
  "version": "0.1.0",
  "description": "EnLearn mobile low-code runtime powered by Hippy and Vue 3.",
  "private": true,
  "webMain": "./src/main-web.ts",
  "nativeMain": "./src/main-native.ts",
  "scripts": {
    "dev": "pnpm hippy:dev",
    "hippy:dev": "node ./scripts/env-polyfill.js hippy-dev -c ./scripts/hippy-webpack.dev.js",
    "hippy:vendor": "node ./scripts/env-polyfill.js webpack --config ./scripts/hippy-webpack.ios-vendor.js --config ./scripts/hippy-webpack.android-vendor.js",
    "hippy:build": "pnpm hippy:vendor && node ./scripts/env-polyfill.js webpack --config ./scripts/hippy-webpack.ios.js --config ./scripts/hippy-webpack.android.js",
    "web:dev": "concurrently --kill-others-on-fail --names hippy,web --prefix-colors magenta,cyan \"pnpm hippy:dev\" \"node ./scripts/env-polyfill.js webpack serve --config ./scripts/hippy-webpack.web-renderer.dev.js\"",
    "web:build": "node ./scripts/env-polyfill.js webpack --config ./scripts/hippy-webpack.web-renderer.js",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test:virtual-table": "node ./tests/virtual-table-regression.mjs",
    "test:virtual-table-scrollbar": "node ./tests/virtual-table-scrollbar-interaction.mjs",
    "test:mobile-form": "node ./tests/mobile-form-regression.mjs",
    "test:page-structure": "node ./tests/page-structure-regression.mjs",
    "test:service-request": "node ./tests/service-request-regression.mjs",
    "test:runtime-cache": "node ./tests/runtime-cache-regression.mjs",
    "test:offline-queue": "node ./tests/offline-queue-regression.mjs",
    "test:network": "node ./tests/network-status-regression.mjs",
    "test:login-web": "node ./tests/login-web-interaction.mjs",
    "test:mes-web": "node ./tests/mes-web-e2e.mjs",
    "test:authorized-pages": "node ./tests/authorized-pages-audit.mjs",
    "test:layout-width": "node ./tests/layout-width-regression.mjs",
    "test:navigation": "node ./tests/navigation-regression.mjs"
  },
  "dependencies": {
    "@hippy/vue-next": "3.3.2",
    "@hippy/vue-router-next-history": "0.0.1",
    "@hippy/web-renderer": "3.3.2",
    "@vue/runtime-core": "3.4.32",
    "@vue/shared": "3.4.32",
    "vue": "3.4.32",
    "vue-router": "4.5.1"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-decorators": "^7.28.0",
    "@babel/plugin-transform-runtime": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@babel/runtime": "^7.28.0",
    "@hippy/debug-server-next": "0.5.7",
    "@hippy/rejection-tracking-polyfill": "^1.0.0",
    "@hippy/vue-css-loader": "3.3.3",
    "@vue/compiler-sfc": "3.4.32",
    "babel-loader": "^8.4.1",
    "case-sensitive-paths-webpack-plugin": "^2.4.0",
    "clean-webpack-plugin": "^4.0.0",
    "@types/node": "^20.19.0",
    "concurrently": "^9.2.0",
    "esbuild": "^0.25.0",
    "esbuild-loader": "^4.3.0",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.6.8",
    "less": "^4.3.0",
    "less-loader": "^13.0.0",
    "playwright-core": "1.57.0",
    "regenerator-runtime": "^0.14.1",
    "ts-loader": "^9.6.2",
    "typescript": "^5.4.5",
    "url-loader": "^4.1.1",
    "vue-loader": "^17.4.2",
    "vue-tsc": "^2.2.12",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2",
    "webpack-dev-server": "^5.2.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED"
}
