{
	"compilerOptions": {
		"target": "ES2022",
		"useDefineForClassFields": true,
		"lib": ["DOM", "DOM.Iterable", "ES2022"],
		"allowJs": false,
		"skipLibCheck": true,
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"baseUrl": ".",
		"types": ["node", "react", "react-dom"],
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"noEmit": true,
		"strict": true,
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"noFallthroughCasesInSwitch": true,
		"paths": {
			"@/*": ["src/*"],
			"~/*": ["../lowcode-framework/src/*"],
			"@enlearn/lowcode-framework": ["../lowcode-framework/src/index.ts"],
			"@enlearn/lowcode-framework/*": ["../lowcode-framework/src/*"],
			"@tldraw/editor": ["packages/editor/src/vue-core.ts"],
			"@tldraw/state": ["packages/state/src/index.ts"],
			"@tldraw/state-react": ["packages/state-react/src/index.ts"],
			"@tldraw/store": ["packages/store/src/index.ts"],
			"@tldraw/tlschema": ["packages/tlschema/src/index.ts"],
			"@tldraw/utils": ["packages/utils/src/index.ts"],
			"@tldraw/validate": ["packages/validate/src/index.ts"],
			"@tiptap/core": ["node_modules/@tiptap/core"],
			"@tiptap/pm": ["node_modules/@tiptap/pm"],
			"@tiptap/pm/*": ["node_modules/@tiptap/pm/*"],
			"@tiptap/react": ["node_modules/@tiptap/react"],
			"classnames": ["node_modules/classnames"],
			"eventemitter3": ["node_modules/eventemitter3"],
			"idb": ["node_modules/idb"],
			"lodash.isequal": ["node_modules/@types/lodash.isequal"],
			"lodash.isequalwith": ["node_modules/@types/lodash.isequalwith"],
			"lodash.throttle": ["node_modules/@types/lodash.throttle"],
			"lodash.uniq": ["node_modules/@types/lodash.uniq"],
			"rbush": ["node_modules/@types/rbush"],
			"react": ["node_modules/@types/react"],
			"react-dom": ["node_modules/@types/react-dom"],
			"react-dom/client": ["node_modules/@types/react-dom/client"],
			"react/jsx-runtime": ["node_modules/@types/react/jsx-runtime"]
		}
	},
	"include": ["src", "vite.config.ts"],
	"exclude": [
		"src/App.vue",
		"src/components/LowCodeFormPanel.vue",
		"src/main.ts"
	]
}
