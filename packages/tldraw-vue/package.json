{
  "name": "tldraw-vue-phase-one",
  "private": false,
  "version": "0.1.2",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/src/index.d.ts",
  "style": "./dist/style.css",
  "exports": {
    ".": {
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "USAGE_API.md",
    "PLUGIN_DEVELOPMENT_PLAN.md"
  ],
  "sideEffects": [
    "*.css",
    "dist/style.css"
  ],
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "vue-tsc --noEmit",
    "build": "pnpm typecheck && vite build && pnpm build:types",
    "build:demo": "pnpm typecheck && vite build --mode demo",
    "build:types": "vue-tsc -p tsconfig.build.json && node scripts/rewrite-type-imports.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@tiptap/core": "^3.12.1",
    "@tiptap/pm": "^3.12.1",
    "@tiptap/react": "^3.12.1",
    "classnames": "^2.5.1",
    "eventemitter3": "^4.0.7",
    "idb": "^7.1.1",
    "is-plain-object": "^5.0.0",
    "lodash.isequal": "^4.5.0",
    "lodash.isequalwith": "^4.4.0",
    "lodash.throttle": "^4.1.1",
    "lodash.uniq": "^4.5.0",
    "qrcode": "^1.5.4",
    "rbush": "^3.0.1",
    "vxe-pc-ui": "^4.16.22",
    "vxe-table": "^4.20.7",
    "vxe-table-plugin-extend-cell-area": "0.1.0"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.2.1",
    "react-dom": "^18.2.0 || ^19.2.1",
    "vue": "^3.5.17"
  },
  "devDependencies": {
    "@enlearn/lowcode-framework": "file:../lowcode-framework",
    "@types/lodash.isequal": "^4.5.8",
    "@types/lodash.isequalwith": "^4.4.9",
    "@types/lodash.throttle": "^4.1.9",
    "@types/lodash.uniq": "^4.5.9",
    "@types/node": "^26.1.1",
    "@types/rbush": "^4.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-vue": "^6.0.5",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "^5.8.3",
    "vite": "^8.0.16",
    "vue": "^3.5.17",
    "vue-tsc": "^3.0.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
