{
	"private": true,
	"name": "@svar-ui/gantt",
	"workspaces": [
		"vue",
		"store",
		"provider",
		"locales"
	],
	"scripts": {
		"build:deps": "run-s build:store build:provider build:locales",
		"build:locales": "cd locales && yarn build",
		"build:provider": "cd provider && shx rm -f ./dist/index.js && yarn build",
		"build:store": "cd store && shx rm -f ./dist/index.js && yarn build",
		"build:vue": "cd vue && yarn build",
		"build:vue-demo": "cd vue && yarn build:demo",
		"build": "yarn build:deps && yarn build:vue && yarn build:vue-demo",
		"lint": "run-s lint:core lint:vue",
		"lint:core": "jiti ./scripts/run-eslint.ts ./store/src ./provider/src ./locales",
		"lint:vue": "cd vue && yarn lint",
		"prepare": "husky",
		"start:demos": "cd vue && yarn dev",
		"start": "yarn build:deps && yarn start:demos",
		"test:core": "vitest --run store/test/public-api.spec.ts store/test/time.spec.ts store/test/tasks.spec.ts store/test/scales.spec.ts store/test/links.spec.ts store/test/scroll.spec.ts store/test/zoom.spec.ts provider/test/provider.spec.ts provider/test/provider-contract.spec.ts",
		"test:vue": "yarn build:locales && cd vue && yarn test",
		"test:upstream": "vitest --run",
		"test": "run-s test:core test:vue",
		"typecheck": "run-s typecheck:core typecheck:locales typecheck:vue typecheck:tools",
		"typecheck:core": "run-p typecheck:store typecheck:provider",
		"typecheck:locales": "cd locales && yarn typecheck",
		"typecheck:provider": "tsc -p provider/tsconfig.json --noEmit",
		"typecheck:store": "tsc -p store/tsconfig.json --noEmit",
		"typecheck:tools": "tsc -p tsconfig.tools.json",
		"typecheck:vue": "cd vue && yarn typecheck",
		"watch:deps": "run-p watch:store watch:provider",
		"watch:provider": "cd provider && shx rm -f ./dist/index.js && yarn watch",
		"watch:store": "cd store && shx rm -f ./dist/index.js && yarn watch",
		"watch": "run-p watch:deps start:demos"
	},
	"devDependencies": {
		"@vitest/coverage-v8": "1.6.0",
		"@svar-ui/vite-tools": "1.0.5",
		"@types/node": "22.10.1",
		"eslint": "9.14.0",
		"eslint-config-prettier": "9.1.0",
		"eslint-plugin-vitest": "0.5.4",
		"husky": "9.1.6",
		"jiti": "2.4.2",
		"lint-staged": "15.2.10",
		"npm-run-all": "4.1.5",
		"prettier": "3.3.3",
		"shx": "0.3.4",
		"typescript-eslint": "8.13.0",
		"typescript": "5.6.3",
		"vite-plugin-conditional-compile": "1.4.5",
		"vite-plugin-dts": "3.7.2",
		"vite": "5.4.10",
		"vitest": "1.5.0"
	},
	"resolutions": {
		"vue": "3.5.40"
	},
	"lint-staged": {
		"*.{ts,js,vue}": [
			"eslint --fix --no-warn-ignored",
			"prettier --write"
		],
		"*.{css,md,json}": [
			"prettier --write"
		]
	}
}
