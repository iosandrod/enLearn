{
	"name": "@svar-ui/vue-gantt",
	"version": "2.7.1",
	"description": "Interactive Vue 3 Gantt chart backed by the SVAR Gantt store",
	"productTag": "gantt",
	"productTrial": true,
	"type": "module",
	"license": "MIT",
	"scripts": {
		"dev": "vite --host 0.0.0.0",
		"predev": "yarn --cwd ../locales build",
		"prebuild": "yarn --cwd ../locales build",
		"prebuild:demo": "yarn --cwd ../locales build",
		"pretest": "yarn --cwd ../locales build",
		"pretypecheck": "yarn --cwd ../locales build",
		"build": "vite build",
		"build:demo": "vite build --mode demo",
		"lint": "jiti ./scripts/run-eslint.ts ./src ./test ./demo",
		"test": "vitest --run",
		"typecheck": "vue-tsc --noEmit"
	},
	"exports": {
		".": {
			"types": "./types/index.d.ts",
			"import": "./dist/index.es.js",
			"require": "./dist/index.cjs",
			"default": "./dist/index.es.js"
		},
		"./style.css": "./dist/index.css",
		"./package.json": "./package.json"
	},
	"types": "./types/index.d.ts",
	"main": "./dist/index.cjs",
	"module": "./dist/index.es.js",
	"files": [
		"dist",
		"types",
		"readme.md",
		"license.txt"
	],
	"dependencies": {
		"@svar-ui/core-locales": "2.6.0",
		"@svar-ui/gantt-data-provider": "2.7.1",
		"@svar-ui/gantt-locales": "2.7.1",
		"@svar-ui/gantt-store": "2.7.1",
		"@svar-ui/grid-store": "2.7.1",
		"@svar-ui/lib-dom": "0.13.1",
		"@svar-ui/lib-state": "1.9.7",
		"@svar-ui/lib-vue": "1.1.0",
		"@svar-ui/vue-core": "2.6.0",
		"@svar-ui/vue-editor": "2.6.0",
		"@svar-ui/vue-grid": "2.7.2",
		"@svar-ui/vue-menu": "2.6.0",
		"@svar-ui/vue-toolbar": "2.6.0"
	},
	"peerDependencies": {
		"vue": "^3.5.40"
	},
	"devDependencies": {
		"@vitejs/plugin-vue": "5.2.4",
		"@vue/test-utils": "2.4.6",
		"eslint-plugin-vue": "10.5.1",
		"jsdom": "24.1.3",
		"vue": "3.5.40",
		"vue-eslint-parser": "10.2.0",
		"vue-tsc": "2.2.12"
	}
}
