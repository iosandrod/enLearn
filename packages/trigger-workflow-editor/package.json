{
  "name": "@enlearn/trigger-workflow-editor",
  "version": "0.1.0",
  "description": "Vue Trigger.dev workflow orchestration editor for approval, data sync, and AI agent flows.",
  "type": "module",
  "private": false,
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@enlearn/lowcode-framework": "workspace:*",
    "@vue-flow/core": "^1.48.2"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "vxe-pc-ui": "^4.16.24"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@vitejs/plugin-vue": "^6.0.4",
    "tsx": "^4.20.6",
    "typescript": "^5.4.5",
    "vite": "^7.3.6",
    "vue": "^3.5.0",
    "vue-tsc": "^3.3.7",
    "vxe-pc-ui": "^4.16.24"
  },
  "scripts": {
    "build": "vite build && vue-tsc --declaration --emitDeclarationOnly -p tsconfig.build.json",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "tsx tests/templates.spec.ts && tsx tests/inspector-form.spec.ts && tsx tests/canvas-tools.spec.ts",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  }
}
