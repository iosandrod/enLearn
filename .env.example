SUPABASE_AUTH_EXTERNAL_GITHUB_REDIRECT_URI="http://127.0.0.1:54321/auth/v1/callback"
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=

# Workflow API backend services
DATABASE_URL="postgres://postgres:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgres://postgres:password@host:5432/postgres"
WORKFLOW_API_PORT=3010
REDIS_URL=redis://127.0.0.1:6379
# Trigger.dev runtime. Project ref, environment secret, and admin PAT are
# resolved from the Trigger.dev database and cached in backend memory.
TRIGGER_API_URL=http://localhost:3030
# Optional when ../trigger.dev-main/.env is not available:
# TRIGGER_ENV_FILE=E:\trigger.dev-main\.env
# TRIGGER_PROJECT_NAME=enlearn-workflow-local
# TRIGGER_ENVIRONMENT=dev
# Optional but required when the UI must verify whether a development worker is online.
# TRIGGER_ACCESS_TOKEN=tr_pat_...
# TRIGGER_CREDENTIAL_CACHE_TTL_MS=300000

# Planning execution
PLANNING_ENGINE_MODE=process
# PLANNING_FREPPLE_EXECUTABLE=frepple
# PLANNING_FREPPLE_BRIDGE=E:\enLearn\api\src\planning-service\execution\frepple-engine.py
# Start the sidecar with: docker compose -f infra/planning/docker-compose.yml up -d --build
# Local API endpoint: http://localhost:8088/solve
# Trigger.dev containers: http://host.docker.internal:8088/solve
# For a sidecar use PLANNING_ENGINE_MODE=http and configure PLANNING_ENGINE_ENDPOINT.
PLANNING_ENGINE_TIMEOUT_MS=3600000
PLANNING_DATABASE_POOL_SIZE=4

# File storage
FILE_STORAGE_DRIVER=supabase
FILE_STORAGE_BUCKET=app-files
FILE_UPLOAD_URL_TTL_SECONDS=900
FILE_DOWNLOAD_URL_TTL_SECONDS=600
FILE_MAX_UPLOAD_BYTES=52428800
