{
  "name": "frepple-ts-core",
  "version": "0.1.0",
  "private": true,
  "description": "Server-side TypeScript implementation of the frePPLe planning core",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.15.3",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.1",
    "fast-check": "^4.1.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "fast-xml-parser": "^5.2.5",
    "graphology": "^0.26.0",
    "graphology-components": "^1.5.4",
    "sorted-btree": "^2.1.0"
  }
}
