# Public gateway port. External projects call this service only.
GATEWAY_PORT=3030

# Internal Trigger.dev API. Run trigger.dev webapp on this port instead of 3030.
TRIGGER_INTERNAL_URL=http://127.0.0.1:3031

# Server-side secret. Do not expose this to browser clients.
# Optional when DATABASE_URL is set. If omitted, the gateway will read/create
# a runtime environment and use its apiKey automatically.
# TRIGGER_SECRET_KEY=tr_dev_replace_me

# Optional bootstrap. When set, the gateway can read/create user/org/project/env
# records and discover TRIGGER_SECRET_KEY by itself.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/triggerdotdev

# Optional. Used only for health/visibility by this gateway, not for key storage.
REDIS_URL=redis://127.0.0.1:6379

# Optional. If omitted and DATABASE_URL is set, the gateway creates or finds one.
TRIGGER_PROJECT_REF=proj_local_gateway

# Bootstrap identity, used only when DATABASE_URL is set.
BOOTSTRAP_USER_EMAIL=gateway@local.dev
BOOTSTRAP_ORG_TITLE=Workflow Engine
BOOTSTRAP_PROJECT_NAME=workflow-engine
BOOTSTRAP_ENVIRONMENT=dev

# Workflow whitelist. External names map to Trigger.dev task IDs.
# JSON form is preferred when you have multiple workflows.
WORKFLOWS={"approval":"approval-workflow"}

# Alternative/env-per-workflow form also works:
# WORKFLOW_APPROVAL_TASK_ID=approval-workflow

# Optional CORS. Empty means no CORS headers.
# CORS_ORIGIN=http://localhost:5173

# Optional request body limit in bytes.
BODY_LIMIT_BYTES=1048576
