# Use the same PostgreSQL database and schema as Trigger.dev.
TRIGGER_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres?schema=public

# Must be the exact same 32-byte value used by the Trigger.dev webapp.
# It is required to encrypt/decrypt the admin Personal Access Token.
TRIGGER_ENCRYPTION_KEY=replace-with-exactly-32-bytes!!!

# Used only if the database has no super-admin yet.
TRIGGER_ADMIN_EMAIL=admin@local.dev
TRIGGER_ADMIN_NAME=Trigger Admin

TRIGGER_ORG_TITLE=Engine
TRIGGER_PROJECT_NAME=enlearn-workflow-local
TRIGGER_ENVIRONMENT=dev
TRIGGER_PAT_NAME=enlearn-engine-bootstrap

# Optional selectors. Existing matching records are reused.
# TRIGGER_PROJECT_REF=proj_replace_me
# TRIGGER_SECRET_KEY=tr_dev_replace_me
