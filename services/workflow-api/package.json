{
  "name": "@enlearn/workflow-api",
  "private": true,
  "version": "0.1.0",
  "description": "NestJS approval workflow microservice for EnLearn.",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "trigger:dev": "trigger dev",
    "trigger:deploy": "trigger deploy",
    "db:apply-trigger-runtime": "tsx scripts/apply-workflow-jobs-migration.ts",
    "db:apply-jobs": "pnpm db:apply-trigger-runtime",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx src/definition/definition.service.spec.ts && tsx src/runtime/runtime.service.spec.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.5",
    "@nestjs/core": "^10.4.5",
    "@nestjs/platform-express": "^10.4.5",
    "@trigger.dev/sdk": "4.5.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@trigger.dev/build": "4.5.7",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.11.10",
    "trigger.dev": "4.5.7",
    "tsx": "^4.19.2",
    "typescript": "^5.4.5"
  },
  "packageManager": "pnpm@10.15.1"
}
