{
  "name": "enlearn-silent-print-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "description": "EnLearn Windows silent printing desktop service",
  "scripts": {
    "dev": "pnpm build && electron .",
    "start": "electron .",
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "dist:win": "pnpm build && electron-builder --win nsis portable"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "electron": "43.7.7",
    "electron-builder": "26.15.3",
    "tsx": "^4.19.2",
    "typescript": "^5.4.5"
  },
  "build": {
    "appId": "com.enlearn.silentprint",
    "productName": "EnLearn 静默打印",
    "asar": true,
    "files": ["dist/**/*", "package.json"],
    "directories": { "output": "release" },
    "win": {
      "target": ["nsis", "portable"],
      "artifactName": "EnLearn-Silent-Print-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "EnLearn 静默打印"
    }
  }
}
